      "item": [
        {
          "id": "22bf5e94-146f-4d7c-aa64-e3fd497cb9f0",
          "name": "WhatsApp Upload Media",
          "request": {
            "name": "WhatsApp Upload Media",
            "description": {
              "content": "Uploads media to WhatsApp servers. Returns a media ID that can be used when sending media messages. Uploaded media persists for 30 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":phone-number-id",
                "media"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "phone-number-id",
                  "description": "(Required) Phone Number ID from the WhatsApp Business Account"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The media file to upload"
                },
                {
                  "key": "type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) MIME type of the file"
                },
                {
                  "key": "messaging_product",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required)  (This can only be one of whatsapp)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "dda5e80d-12c7-4a9c-a7a9-9cfdd1944b2c",
              "name": "Media uploaded successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    ":phone-number-id",
                    "media"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "phone-number-id",
                      "description": "(Required) Phone Number ID from the WhatsApp Business Account"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) The media file to upload",
                        "type": "text/plain"
                      },
                      "key": "file",
                      "value": "<binary>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required) MIME type of the file",
                        "type": "text/plain"
                      },
                      "key": "type",
                      "value": "image/jpeg",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required)  (This can only be one of whatsapp)",
                        "type": "text/plain"
                      },
                      "key": "messaging_product",
                      "value": "<string>",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
